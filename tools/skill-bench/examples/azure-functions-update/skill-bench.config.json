{
  "title": "Azure Functions Skills: update",
  "models": ["claude-sonnet-5", "gpt-6-astra", "gpt-6-sol", "claude-opus-5.5", "gpt-6-luna", "mai-code-1.1-flash"],
  "tiers": {
    "powerful": ["gpt-6-astra", "gpt-6-sol", "claude-opus-5.5"],
    "medium": ["claude-sonnet-5"],
    "low": ["gpt-6-luna", "mai-code-1.1-flash"]
  },
  "timeout": "15m",
  "disabledSkills": ["customize-cloud-agent", "github-pr-media"],
  "skills": {
    "azure-functions-update": {
      "skillDir": "../../../../templates/skills/azure-functions-update",
      "files": ["SKILL.md", "references/dotnet-isolated.md"],
      "evals": [
        {
          "path": "evals/dotnet-isolated/eval.yaml",
          "copies": [
            { "from": "fixtures/UpgradeApp.csproj", "to": "grader-baseline/UpgradeApp.csproj.txt" },
            { "from": "fixtures/Hello.cs", "to": "grader-baseline/Hello.cs.txt" },
            { "from": "fixtures/host.json", "to": "grader-baseline/host.json.txt" },
            { "from": "fixtures/Startup.cs", "to": "grader-baseline/Startup.cs.txt" },
            { "from": "fixtures/GreetingService.cs", "to": "grader-baseline/GreetingService.cs.txt" },
            { "from": "fixtures/QueueGreeting.cs", "to": "grader-baseline/QueueGreeting.cs.txt" }
          ]
        }
      ],
      "plugins": {
        "graders": ["plugins/functions-code-review.ts"],
        "preflight": [
          {
            "module": "plugins/host-preflight.ts",
            "options": {
              "tools": {
                "dotnet": { "args": ["--version"], "version": "10.0.401" },
                "func": { "args": ["--version"], "version": "4.15.1" }
              },
              "installed": {
                "dotnet": { "args": ["--list-sdks"], "versions": ["10.0.401", "8.0.425"] }
              },
              "ports": { "azurite-blob": 10000, "azurite-queue": 10001 },
              "readyTimeoutSeconds": 60
            }
          },
          {
            "module": "plugins/nuget-preflight.ts",
            "options": {
              "targetFramework": "net8.0",
              "sdk": "Azure.Functions.Sdk/1.0.0",
              "packages": { "Microsoft.Azure.Functions.Worker": "2.50.0" }
            }
          }
        ]
      }
    }
  },
  "env": {
    "VALLY_EVAL_OWNS_AZURITE_RESOURCES": "1",
    "FUNCTIONS_CORE_TOOLS_TELEMETRY_OPTOUT": "1",
    "MSBuildNodeReuse": "false",
    "DOTNET_CLI_USE_MSBUILD_SERVER": "0",
    "UseSharedCompilation": "false"
  },
  "redaction": { "keepValues": ["dotnet", "dotnet-isolated", "UseDevelopmentStorage=true"] },
  "display": {
    "models": {
      "claude-sonnet-5": "Claude Sonnet 5", "gpt-6-astra": "GPT-6 Astra", "gpt-6-sol": "GPT-6 Sol",
      "claude-opus-5.5": "Claude Opus 5.5", "gpt-6-luna": "GPT-6 Luna",
      "mai-code-1.1-flash": "MAI-Code-1.1-Flash"
    },
    "skills": { "azure-functions-update": "Update an app" },
    "scenarios": { "dotnet-isolated": "Migrate .NET in-process to the isolated worker" }
  }
}
