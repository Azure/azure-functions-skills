{
  "name": "intelligent-function-app-studio",
  "version": "0.3.0",
  "type": "module",
  "main": "extension.mjs",
  "private": true,
  "description": "Functions Hosted Skills Studio builds Hosted Skills with Timer, HTTP, Queue, and Microsoft 365 Inbox triggers locally or works with an existing Azure Function App.",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=*.mjs --test-coverage-include=shared/function-app-core/src/*.mjs --test-coverage-exclude=bootstrap-extension.mjs --test-coverage-exclude=extension.mjs --test-coverage-exclude=studio-commands.mjs --test-coverage-exclude=vitest.config.mjs --test-coverage-branches=75 --test-coverage-functions=95 --test-coverage-lines=95 --test test/*.test.mjs shared/function-app-core/test/*.test.mjs"
  },
  "dependencies": {
    "@cloud-foundation/function-app-core": "file:./shared/function-app-core",
    "@github/copilot-sdk": "latest"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  },
  "keywords": [
    "azure-functions",
    "serverless-agents",
    "event-driven",
    "copilot-canvas",
    "cloud-foundation",
    "azure-functions-core-tools",
    "application-insights"
  ]
}
